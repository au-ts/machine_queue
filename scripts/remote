if [ "${SCRIPT_PATH}" = "" ]; then
    echo "This script should not be called directly! Please use mq.sh"
    exit -1
fi

SSH_COMMON_OPTS="-oLogLevel=quiet -oBatchMode=yes"

RemoteCommandOnInternal() {
    host="$1"
    tty_mode="$2"
    shift 2
    cmd="$*"

    if [ "${tty_mode}" = "tty" ]; then
        ssh -o Compression=no -tt ${SSH_COMMON_OPTS} "${host}" "stty isig -onlcr -echoctl -echo ; ${cmd}"
    else
        ssh -o Compression=no -T ${SSH_COMMON_OPTS} "${host}" "${cmd}"
    fi
    return $?
}

RemoteCommandOn() {
    host="$1"
    shift
    RemoteCommandOnInternal "${host}" no-tty "$@"
}

RemoteTTYCommandOn() {
    host="$1"
    shift
    RemoteCommandOnInternal "${host}" tty "$@"
}

RemoteCommand() {
    if [ "$(hostname -f)" = "${HOST}" ]; then
        (
            eval "$@"
        )
        return $?
    fi
    RemoteCommandOn "${HOST}" "$@"
}

RemoteTTYCommand() {
    if [ "$(hostname -f)" = "${HOST}" ]; then
        (
            eval "$@"
        )
        return $?
    fi
    RemoteTTYCommandOn "${HOST}" "$@"
}
