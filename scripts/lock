if [ ! "${SCRIPT_PATH}" ]; then
    echo "This script should not be called directly! Please use mq.sh"
    exit 1
fi

LockName() {
    echo "${BASE}/$1.lock"
}

KeyName() {
    echo "${BASE}/$1.key"
}

LockHelperCommand() {
    cmd="$1"
    shift
    RemoteCommand "'${BASE}/scripts/lock_helper' '${BASE}' '${cmd}' $*"
}

LockOwner() {
    LockHelperCommand owner "'$(printf "%s" "$1" | sed "s/'/'\\''/g")'"
}

LockGetInfo() {
    LockHelperCommand info "'$(printf "%s" "$1" | sed "s/'/'\\''/g")'"
}

LockGetKey() {
    LockHelperCommand key "'$(printf "%s" "$1" | sed "s/'/'\\''/g")'"
}

LockIOwn() {
    owner="$(LockOwner "$1")"
    [ "${owner}" = "${REMOTEUSER}" ]
}

LockTimeout() {
    LockHelperCommand timeout "'$(printf "%s" "$1" | sed "s/'/'\\''/g")'"
}

GetAllLockedSystems() {
    LockHelperCommand list-locked |
	grep -F "`SystemList`"
    echo
}

LockReadState() {
    LockHelperCommand state "'$(printf "%s" "$1" | sed "s/'/'\\''/g")'"
}

LockSystemPrintInfo() {
    system="$1"

    state="$(LockReadState "$system")"
    owner=$(printf '%s' "$state" | cut -f 1)
    since=$(printf '%s' "$state" | cut -f 2)
    timeout=$(printf '%s' "$state" | cut -f 3)
    lockkey=$(printf '%s' "$state" | cut -f 4)

    if [ ! "${owner}" ]; then
        echo "Lock for $system currently free"
        return
    fi
    printf "Lock for $system held by $owner since $since, timeout $timeout"
    if [ "${lockkey}" != "0" ] && [ -n "${lockkey}" ]; then
        echo " with key '${lockkey}'"
    else
        echo ""
    fi
}

# This prints the status of the lock in a more machine-readable format
LockSystemDumpInfo() {
    system="$1"
    state=$(LockReadState "$1")
    owner=$(printf '%s' "$state" | cut -f 1)
    since=$(printf '%s' "$state" | cut -f 2)
    lockkey=$(printf '%s' "$state" | cut -f 4)
    printf "$system"
    if [ "${owner}" = "" ];
    then
    printf " FREE"
    else
    printf " LOCKED"
    printf " $owner"
    printf " $since"
        if [ "${lockkey}" != "0" ] && [ -n "${lockkey}" ];
    then
            printf " ${lockkey}"
    fi
    fi
    echo
}

LockSystemDumpAll() {
    for x in $(GetAllLockedSystems)
    do
	LockSystemDumpInfo "$x"
    done
}

LockSystem() {
    system="$1"
    retry_period="$2"
    total_retries="$3"
    key="$4"
    newtimeout="$5"

    LockHelperCommand acquire \
        "'$(printf "%s" "$system" | sed "s/'/'\\''/g")'" \
        "'$(printf "%s" "$REMOTEUSER" | sed "s/'/'\\''/g")'" \
        "'${retry_period}'" \
        "'${total_retries}'" \
        "'$(printf "%s" "$key" | sed "s/'/'\\''/g")'" \
        "'${newtimeout}'"
    rc=$?

    case "$rc" in
        0)
            return 0
            ;;
        11)
            return 1
            ;;
        12)
            return 2
            ;;
        *)
            return 3
            ;;
    esac
}

UnlockSystem() {
    system="$1"
    force="$2"
    key="$3"

    LockHelperCommand release \
        "'$(printf "%s" "$system" | sed "s/'/'\\''/g")'" \
        "'$(printf "%s" "$REMOTEUSER" | sed "s/'/'\\''/g")'" \
        "'${force}'" \
        "'$(printf "%s" "$key" | sed "s/'/'\\''/g")'"
}

# Kills (TERM) processes on the server that are waiting for specified lock and key.
# Only kills processes of the current user.
# This correctly signals to client that lock acquisition has failed, but also works
# when the client has already been killed and only the server process is left over.
CancelWait() {
    system="$1"
    key="$2"

    LockHelperCommand cancel-wait \
        "'$(printf "%s" "$system" | sed "s/'/'\\''/g")'" \
        "'$(printf "%s" "$REMOTEUSER" | sed "s/'/'\\''/g")'" \
        "'$(printf "%s" "$key" | sed "s/'/'\\''/g")'"
}

UserLockUsage() {
    echo "$0 sem -signal|-wait|-cancel|-info SYSTEM [-f] [-w retry-time] [-t retry-count] [-k LOCK_KEY]"
    echo "$0 sem dumpall"
    echo
    echo "   Manually manipulate locks for machines. The lock for each system"
    echo "   can be acquired or released."
    echo
    echo "   You can forcibly release a lock for a system that you do not"
    echo "   currently own by the -f flag"
    echo
    echo " Options:"
    echo
    echo " -info SYSTEM     Display lock information for the specified SYSTEM"
    echo " -mr-info SYSTEM  Display lock information for the specified SYSTEM in machine-readable format"
    echo " -signal SYSTEM   Release the lock for the specified SYSTEM"
    echo " -wait SYSTEM     Acquire the lock for the specified SYSTEM"
    echo " -cancel SYSTEM   Cancel '-wait' processes on the server that are waiting for specified SYSTEM and key"
    echo " -w TIME          Number of seconds to wait between each attempt to acquire the lock (default 8)"
    echo " -t RETRIES       Number of retries to preform for acquiring the lock (default -1)"
    echo " -f               Forcefully releases a lock even if you are not the owner"
    echo " -k LOCK_KEY      Set a key inside the lock"
    echo " -T timeout       Allow lock to be reclaimed after timeout seconds"
    echo " dumpall          Prints all currently locked systems"
    echo
}

UserLock() {
    retry_period=8
    total_retries=-1
    force=0
    key="0"
    timeout=0
    while [ "$#" -ne 0 ]; do
        case "$1" in
            -info)
                shift
                system="$1"
                action="-info"
            ;;
            -mr-info)
                shift
                system="$1"
                action="-mr-info"
            ;;
            -signal)
                shift
                system="$1"
                action="-signal"
            ;;
            -wait)
                shift
                system="$1"
                action="-wait"
            ;;
            -cancel)
                shift
                system="$1"
                action="-cancel"
            ;;
            -w)
		shift
                retry_period="$1"
            ;;
            -t)
                shift
                total_retries="$1"
            ;;
            -f)
                force=1
            ;;
            -k)
                shift
                key="$1"
		;;
	    -T)
		shift
		timeout="$1"
		;;
            dumpall)
		LockSystemDumpAll
		exit $?
		;;
            *)
                echo "Unknown option $1"
                UserLockUsage
                exit 1
            ;;
        esac
        shift
    done

    case "$action" in
        -info)
            LockSystemPrintInfo "$system"
            ;;
        -mr-info)
            LockSystemDumpInfo "$system"
            ;;
        -signal)
            UnlockSystem "$system" "$force" "$key"
            ;;
        -wait)
            LockSystem "$system" "$retry_period" "$total_retries" "$key" "$timeout"
            ;;
        -cancel)
            CancelWait "$system" "$key"
            ;;
        *)
            UserLockUsage
            exit 1
            ;;
    esac

    exit $?
}
